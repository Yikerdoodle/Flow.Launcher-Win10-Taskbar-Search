<UserControl
    x:Class="Flow.Launcher.StartMenu.StartMenuPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="clr-namespace:iNKORE.UI.WPF.Modern.Markup;assembly=iNKORE.UI.WPF.Modern"
    xmlns:sm="clr-namespace:Flow.Launcher.StartMenu"
    Background="{DynamicResource Win10StartBackground}"
    ClipToBounds="True"
    Focusable="False"
    MouseLeftButtonDown="OnPanelMouseDown"
    TextOptions.TextFormattingMode="Ideal">
    <!--
        The Windows 10 Start menu, measured on the Windows 10 Start menu at 150% scaling (sizes are in DIP): a 48 wide
        rail with 48 high buttons, and the All apps list with 36 high rows, 24 icons 4 in from the list's left edge,
        names 36 in, and a 14 wide gutter on the right for the scroll bar. Text sizes follow the Windows text size
        setting the way Start does (see StartMenuPanel.xaml.cs).
    -->
    <UserControl.Resources>
        <FontFamily x:Key="StartIconFont">Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="StartAccentBrush" Color="{m:DynamicColor SystemAccentColor}" />
        <SolidColorBrush x:Key="StartSelectedBrush" Color="{m:DynamicColor SystemAccentColorLight2}" />
        <SolidColorBrush x:Key="StartLinkBrush" Color="{m:DynamicColor SystemAccentColorLight3}" />

        <!--  Start's own flat folder icon (not Explorer's), drawn from the measured pixels: a darker tab, the back
              edge, and the front with a light-to-dark diagonal gradient  -->
        <DrawingImage x:Key="StartFolderIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M0,0 H24 V24 H0 Z" Brush="Transparent" />
                    <GeometryDrawing Geometry="M0.67,4 A1.33,1.33 0 0 1 2,2.67 H9.33 L11,5.67 H22.67 V8 H0.67 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#E09F00" />
                                <GradientStop Offset="0.6" Color="#D49000" />
                                <GradientStop Offset="0.61" Color="#FFD35A" />
                                <GradientStop Offset="1" Color="#FFD35A" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M0.67,7 H22.67 V20 A1.33,1.33 0 0 1 21.33,21.33 H2 A1.33,1.33 0 0 1 0.67,20 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FFD967" />
                                <GradientStop Offset="0.5" Color="#FECE47" />
                                <GradientStop Offset="1" Color="#F6B61E" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="StartText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="{DynamicResource StartFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource Win10StartText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="StartGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource StartIconFont}" />
            <Setter Property="Foreground" Value="{DynamicResource Win10StartText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  A row of the list: the hover light, and the whole row takes clicks  -->
        <Style x:Key="StartRow" TargetType="Border">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0 0 14 0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="sm:StartMenuReveal.IsEnabled" Value="True" />
        </Style>

        <DataTemplate DataType="{x:Type sm:AllAppsHeader}">
            <Border MouseLeftButtonUp="OnHeaderClick" Style="{StaticResource StartRow}">
                <Grid>
                    <!--  A letter sits centered over the icons; "Recently added" starts at the icons' left edge  -->
                    <TextBlock
                        x:Name="Letter"
                        Width="24"
                        Margin="4 -4 0 0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource StartText}"
                        Text="{Binding Text}"
                        TextAlignment="Center"
                        TextTrimming="None" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="recent">
                    <Setter TargetName="Letter" Property="Width" Value="NaN" />
                    <Setter TargetName="Letter" Property="TextAlignment" Value="Left" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="other">
                    <Setter TargetName="Letter" Property="FontFamily" Value="{StaticResource StartIconFont}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type sm:AllAppsExpander}">
            <Border MouseLeftButtonUp="OnExpanderClick" Style="{StaticResource StartRow}">
                <StackPanel Margin="2.67 -1.33 0 0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StartText}" Text="{Binding Text}" />
                    <TextBlock
                        x:Name="Chevron"
                        Margin="4.67 2 0 0"
                        FontSize="{DynamicResource StartChevronSize}"
                        Style="{StaticResource StartGlyph}"
                        Text="&#xE70D;" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type sm:AllAppsItem}">
            <Border
                MouseLeftButtonUp="OnItemClick"
                MouseRightButtonUp="OnItemRightClick"
                Style="{StaticResource StartRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="Icon"
                        Width="24"
                        Height="24"
                        Margin="4 0 0 0"
                        HorizontalAlignment="Left"
                        RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <!--  In a style, so the folder trigger below can replace it  -->
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{Binding Icon}" />
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock
                        Grid.Column="1"
                        Margin="0 -1.33 0 0"
                        Style="{StaticResource StartText}"
                        Text="{Binding Name}" />
                    <TextBlock
                        x:Name="Chevron"
                        Grid.Column="2"
                        Margin="8 0.67 8 0"
                        FontSize="{DynamicResource StartChevronSize}"
                        Style="{StaticResource StartGlyph}"
                        Text="&#xE70D;"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Icon" Property="Source" Value="{StaticResource StartFolderIcon}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  A cell of the letter grid  -->
        <DataTemplate x:Key="JumpCellTemplate" DataType="{x:Type sm:JumpCell}">
            <Border
                Width="48"
                Height="48"
                Margin="2"
                sm:StartMenuReveal.IsEnabled="True"
                Background="Transparent"
                MouseLeftButtonUp="OnJumpCellClick">
                <TextBlock
                    x:Name="Text"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="{DynamicResource StartJumpFontSize}"
                    Foreground="{DynamicResource Win10StartText}"
                    Style="{StaticResource StartGlyph}"
                    Text="{Binding Text}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGlyph}" Value="True">
                    <Setter TargetName="Text" Property="FontFamily" Value="{StaticResource StartIconFont}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Win10StartDisabledText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  A rail button: the accent bar and accent color when it is the current view, the label to the right  -->
        <Style x:Key="RailButton" TargetType="Border">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="sm:StartMenuReveal.IsEnabled" Value="True" />
        </Style>
        <Style x:Key="RailGlyph" TargetType="TextBlock" BasedOn="{StaticResource StartGlyph}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Margin" Value="17.33 0 0 0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="RailLabel" TargetType="TextBlock" BasedOn="{StaticResource StartText}">
            <Setter Property="Margin" Value="48 0 0 0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="{DynamicResource StartRailFontSize}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--  Views, right of the rail  -->
        <Grid Margin="48 0 0 0">
            <ScrollViewer
                x:Name="AllAppsScroller"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                Template="{DynamicResource ScrollViewerControlTemplate}"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="AllAppsItems"
                    Margin="0 7.33 0 0"
                    Focusable="False"
                    VirtualizingPanel.IsVirtualizing="False" />
            </ScrollViewer>

            <!--  The letter grid ("semantic zoom"), shown in place of the list after clicking a group header  -->
            <Grid
                x:Name="JumpGrid"
                Background="Transparent"
                MouseLeftButtonUp="OnJumpGridBackgroundClick"
                Visibility="Collapsed">
                <ItemsControl
                    x:Name="JumpItems"
                    Width="208"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Focusable="False"
                    ItemTemplate="{StaticResource JumpCellTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <Grid x:Name="PinnedView" Visibility="Collapsed" />
        </Grid>

        <!--  The rail; expanding it shows the labels over the list  -->
        <Border
            x:Name="Rail"
            Width="48"
            HorizontalAlignment="Left"
            Background="Transparent"
            ClipToBounds="True"
            MouseEnter="OnRailMouseEnter"
            MouseLeave="OnRailMouseLeave">
            <DockPanel LastChildFill="False">
                <StackPanel Margin="0 4 0 0" DockPanel.Dock="Top">
                    <Border MouseLeftButtonUp="OnMenuClick" Style="{StaticResource RailButton}">
                        <Grid>
                            <TextBlock Style="{StaticResource RailGlyph}" Text="&#xE700;" />
                            <TextBlock
                                FontWeight="Bold"
                                Style="{StaticResource RailLabel}"
                                Text="START" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="PinnedButton"
                        MouseLeftButtonUp="OnPinnedClick"
                        Style="{StaticResource RailButton}">
                        <Grid>
                            <Rectangle
                                x:Name="PinnedBar"
                                Width="4"
                                HorizontalAlignment="Left"
                                Fill="{DynamicResource StartAccentBrush}"
                                Visibility="Hidden" />
                            <TextBlock
                                x:Name="PinnedGlyph"
                                Style="{StaticResource RailGlyph}"
                                Text="&#xECA5;" />
                            <TextBlock
                                x:Name="PinnedLabel"
                                Style="{StaticResource RailLabel}"
                                Text="Pinned tiles" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="AllAppsButton"
                        MouseLeftButtonUp="OnAllAppsClick"
                        Style="{StaticResource RailButton}">
                        <Grid>
                            <Rectangle
                                x:Name="AllAppsBar"
                                Width="4"
                                HorizontalAlignment="Left"
                                Fill="{DynamicResource StartAccentBrush}"
                                Visibility="Hidden" />
                            <TextBlock
                                x:Name="AllAppsGlyph"
                                Style="{StaticResource RailGlyph}"
                                Text="&#xE71D;" />
                            <TextBlock
                                x:Name="AllAppsLabel"
                                Style="{StaticResource RailLabel}"
                                Text="All apps" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border MouseLeftButtonUp="OnAccountClick" Style="{StaticResource RailButton}">
                        <Grid>
                            <Ellipse
                                x:Name="AccountPicture"
                                Width="20"
                                Height="20"
                                Margin="15.33 -1.33 0 0"
                                HorizontalAlignment="Left"
                                Fill="{DynamicResource Win10StartDisabledText}" />
                            <TextBlock
                                x:Name="AccountName"
                                Style="{StaticResource RailLabel}" />
                        </Grid>
                    </Border>
                    <Border MouseLeftButtonUp="OnSettingsClick" Style="{StaticResource RailButton}">
                        <Grid>
                            <TextBlock Style="{StaticResource RailGlyph}" Text="&#xE713;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="Settings" />
                        </Grid>
                    </Border>
                    <Border MouseLeftButtonUp="OnPowerClick" Style="{StaticResource RailButton}">
                        <Grid>
                            <TextBlock Style="{StaticResource RailGlyph}" Text="&#xE7E8;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="Power" />
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  The Power and account menus, drawn over the panel like Start's: 258 wide with a thin dark outline, rows
              44 high with the icon 16 in and the label 44 in, 4.67 above the button that opened it. Clicking
              anywhere else closes it  -->
        <Grid
            x:Name="FlyoutLayer"
            Background="Transparent"
            MouseLeftButtonUp="OnFlyoutLayerClick"
            Visibility="Collapsed">
            <Border
                x:Name="Flyout"
                Width="258"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Win10StartFlyoutBackground}"
                BorderBrush="{DynamicResource Win10StartFlyoutBorder}"
                BorderThickness="1.33"
                MouseLeftButtonUp="OnFlyoutClick"
                Padding="0 5.33 0 2.67">
                <ItemsControl x:Name="FlyoutItems" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type sm:StartFlyoutItem}">
                            <Border
                                Height="44"
                                MouseLeftButtonUp="OnFlyoutItemClick"
                                Style="{StaticResource RailButton}">
                                <Grid>
                                    <TextBlock
                                        Width="16"
                                        Margin="16 0 0 0"
                                        HorizontalAlignment="Left"
                                        FontSize="16"
                                        Style="{StaticResource StartGlyph}"
                                        Text="{Binding Glyph}" />
                                    <TextBlock
                                        x:Name="Label"
                                        Margin="44 0 12 0"
                                        Style="{StaticResource StartText}"
                                        Text="{Binding Text}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!--  Text-only menus (the account menu) start their labels where the icons would be  -->
                                <DataTrigger Binding="{Binding Glyph}" Value="{x:Null}">
                                    <Setter TargetName="Label" Property="Margin" Value="16 0 12 0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--  The account box, measured from Start's: 358.67 x 173.33 with the same outline, 4 above the account
                  button. The Microsoft logo and name, the email and "My Microsoft account" only show for a Microsoft
                  account. Positions are from the box's inside edge  -->
            <Border
                x:Name="AccountFlyout"
                Width="358.67"
                Height="173.33"
                Margin="0 0 0 148"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Win10StartFlyoutBackground}"
                BorderBrush="{DynamicResource Win10StartFlyoutBorder}"
                BorderThickness="1.33"
                MouseLeftButtonUp="OnFlyoutClick"
                Visibility="Collapsed">
                <Grid>
                    <!--  Microsoft logo: four 8.67 squares 1.33 apart, and the wordmark  -->
                    <Grid
                        x:Name="MicrosoftLogo"
                        Width="18.67"
                        Height="18.67"
                        Margin="17.33 20.67 0 0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <Rectangle Width="8.67" Height="8.67" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#F25022" />
                        <Rectangle Width="8.67" Height="8.67" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#7FBA00" />
                        <Rectangle Width="8.67" Height="8.67" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#00A4EF" />
                        <Rectangle Width="8.67" Height="8.67" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#FFB900" />
                    </Grid>
                    <TextBlock
                        x:Name="MicrosoftWordmark"
                        Margin="41.33 16.17 0 0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontFamily="Segoe UI"
                        FontSize="{DynamicResource StartAccountSmallFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Win10StartSecondaryAccountText}"
                        Text="Microsoft" />

                    <Border
                        Margin="203.33 11.33 0 0"
                        Padding="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        sm:StartMenuReveal.IsEnabled="True"
                        Background="Transparent"
                        MouseLeftButtonUp="OnSignOutClick">
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="{DynamicResource StartAccountSmallFontSize}"
                            Foreground="{DynamicResource Win10StartText}"
                            Text="Sign out" />
                    </Border>
                    <Border
                        Margin="309.07 8.54 0 0"
                        Padding="4 8 4 8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        sm:StartMenuReveal.IsEnabled="True"
                        Background="Transparent"
                        MouseLeftButtonUp="OnAccountMoreClick">
                        <TextBlock
                            FontFamily="{StaticResource StartIconFont}"
                            FontSize="{DynamicResource StartAccountNameFontSize}"
                            Foreground="{DynamicResource Win10StartText}"
                            Text="&#xE712;" />
                    </Border>

                    <Ellipse
                        x:Name="AccountBigPicture"
                        Width="58"
                        Height="58"
                        Margin="16 77.33 0 0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="{DynamicResource Win10StartDisabledText}" />
                    <TextBlock
                        x:Name="AccountFullName"
                        Width="260"
                        Margin="86.33 59.67 0 0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontFamily="Segoe UI"
                        FontSize="{DynamicResource StartAccountNameFontSize}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Win10StartText}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="AccountEmail"
                        Width="259.33"
                        Margin="86 93.8 0 0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontFamily="Segoe UI"
                        FontSize="{DynamicResource StartFontSize}"
                        Foreground="{DynamicResource Win10StartSecondaryAccountText}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="MicrosoftAccountLink"
                        Margin="85.73 123.27 0 0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Cursor="Hand"
                        FontFamily="Segoe UI"
                        FontSize="{DynamicResource StartFontSize}"
                        Foreground="{DynamicResource StartLinkBrush}"
                        MouseLeftButtonUp="OnMicrosoftAccountClick"
                        Text="My Microsoft account">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
